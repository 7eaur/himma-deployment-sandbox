# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=himma
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DB_NAME=himma_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=REPLACE_WITH_LOCAL_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_LOCAL_SECRET_KEY
S3_BUCKET_NAME=himma-storage

# API Settings
API_PORT=8000
API_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ORIGINS=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_LOCAL_RESEARCHER_PASSWORD
SEED_DEMO_STUDENTS=false
# TEMPORARY — disable when the production audio pipeline is activated.
HIMMA_TEMP_AUDIO_SKIP=true
ENV=development

# Next.js Web URL
NEXT_PUBLIC_API_URL=http://localhost:8000
