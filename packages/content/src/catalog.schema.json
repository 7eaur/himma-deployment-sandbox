{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himma.local/schemas/content-catalog-v1.json",
  "title": "Himma approved content catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "language",
    "direction",
    "source",
    "constraints",
    "summary",
    "levels",
    "skills",
    "media_gaps",
    "items",
    "manifest_inventory"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "catalog_version": { "type": "string", "minLength": 1 },
    "language": { "const": "ar" },
    "direction": { "const": "rtl" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "original_path", "original_sha256", "derived_path", "derived_sha256"],
      "properties": {
        "authority": { "const": "client_approved_docx" },
        "original_path": { "type": "string", "minLength": 1 },
        "original_sha256": { "$ref": "#/$defs/sha256" },
        "derived_path": { "type": "string", "minLength": 1 },
        "derived_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pretest_questions",
        "posttest_questions",
        "assessment_level_distribution",
        "core_activities_per_level",
        "reinforcement_activities_per_level",
        "allowed_interactions",
        "one_skill_per_item",
        "one_interaction_per_item"
      ],
      "properties": {
        "pretest_questions": { "const": 30 },
        "posttest_questions": { "const": 30 },
        "assessment_level_distribution": { "const": { "1": 10, "2": 12, "3": 8 } },
        "core_activities_per_level": { "const": 10 },
        "reinforcement_activities_per_level": { "const": 5 },
        "allowed_interactions": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/interaction_type" }
        },
        "one_skill_per_item": { "const": true },
        "one_interaction_per_item": { "const": true }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_count", "skill_count", "kind_counts", "activity_counts_by_level", "declared_media_gap_count"],
      "properties": {
        "item_count": { "const": 105 },
        "skill_count": { "type": "integer", "minimum": 1 },
        "kind_counts": {
          "const": {
            "core_activity": 30,
            "posttest_question": 30,
            "pretest_question": 30,
            "reinforcement_activity": 15
          }
        },
        "activity_counts_by_level": {
          "const": {
            "1": { "core": 10, "reinforcement": 5 },
            "2": { "core": 10, "reinforcement": 5 },
            "3": { "core": 10, "reinforcement": 5 }
          }
        },
        "declared_media_gap_count": { "type": "integer", "minimum": 0 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/level" }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    },
    "media_gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/top_level_media_gap" }
    },
    "items": {
      "type": "array",
      "minItems": 105,
      "maxItems": 105,
      "items": { "$ref": "#/$defs/content_item" }
    },
    "manifest_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_asset_ids", "image_asset_ids"],
      "properties": {
        "audio_asset_ids": { "$ref": "#/$defs/unique_string_array" },
        "image_asset_ids": { "$ref": "#/$defs/unique_string_array" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "unique_string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "interaction_type": {
      "enum": [
        "build_word",
        "choose_image",
        "choose_many",
        "choose_one",
        "listen_choose_image",
        "listen_choose_many",
        "listen_choose_one",
        "memory_sequence",
        "path_sequence",
        "read_aloud",
        "sequence",
        "timed_read_aloud"
      ]
    },
    "media_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "asset_type", "usage", "semantic_text"],
      "properties": {
        "asset_id": { "type": "string", "pattern": "^[A-Z]+-[0-9]{2}$" },
        "asset_type": { "enum": ["audio", "image"] },
        "usage": { "type": "string", "minLength": 1 },
        "semantic_text": { "type": "string", "minLength": 1 }
      }
    },
    "media_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_type", "usage", "semantic_text", "status", "reason", "impact"],
      "properties": {
        "asset_type": { "enum": ["audio", "image"] },
        "usage": { "type": "string", "minLength": 1 },
        "semantic_text": { "type": "string", "minLength": 1 },
        "status": { "const": "declared_missing" },
        "reason": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 }
      }
    },
    "top_level_media_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "round_id", "asset_type", "usage", "semantic_text", "status", "reason", "impact"],
      "properties": {
        "item_id": { "$ref": "#/$defs/canonical_id" },
        "round_id": { "type": "string", "minLength": 1 },
        "asset_type": { "enum": ["audio", "image"] },
        "usage": { "type": "string", "minLength": 1 },
        "semantic_text": { "type": "string", "minLength": 1 },
        "status": { "const": "declared_missing" },
        "reason": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_id", "order_index", "source_text", "media", "media_gaps"],
      "properties": {
        "round_id": { "type": "string", "minLength": 1 },
        "order_index": { "type": "integer", "minimum": 1 },
        "source_text": { "type": "string", "minLength": 1 },
        "media": { "type": "array", "items": { "$ref": "#/$defs/media_ref" } },
        "media_gaps": { "type": "array", "items": { "$ref": "#/$defs/media_gap" } }
      }
    },
    "canonical_id": {
      "type": "string",
      "pattern": "^((PRE|POST)-Q[0-9]{2}|L[1-3]-(CORE|REIN)-[0-9]{2})$"
    },
    "content_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_id",
        "stable_key",
        "kind",
        "level_id",
        "order_index",
        "title",
        "skill_id",
        "skill_name",
        "source_skill_name",
        "interaction_type",
        "source_method",
        "criterion",
        "note",
        "item_assets",
        "rounds",
        "checksum"
      ],
      "properties": {
        "canonical_id": { "$ref": "#/$defs/canonical_id" },
        "stable_key": { "type": "string", "format": "uuid" },
        "kind": {
          "enum": ["pretest_question", "posttest_question", "core_activity", "reinforcement_activity"]
        },
        "level_id": { "type": "integer", "minimum": 1, "maximum": 3 },
        "order_index": { "type": "integer", "minimum": 1, "maximum": 30 },
        "title": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "format": "uuid" },
        "skill_name": { "type": "string", "minLength": 1 },
        "source_skill_name": { "type": "string", "minLength": 1 },
        "interaction_type": { "$ref": "#/$defs/interaction_type" },
        "source_method": { "type": "string", "minLength": 1 },
        "criterion": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "item_assets": { "type": "array", "items": { "$ref": "#/$defs/media_ref" } },
        "rounds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/round" } },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "skill_code", "level_id", "name"],
      "properties": {
        "skill_id": { "type": "string", "format": "uuid" },
        "skill_code": { "type": "string", "pattern": "^[a-z][a-z0-9_]+$" },
        "level_id": { "type": "integer", "minimum": 1, "maximum": 3 },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level_id", "name", "core_activity_ids", "reinforcement_activity_ids"],
      "properties": {
        "level_id": { "type": "integer", "minimum": 1, "maximum": 3 },
        "name": { "type": "string", "minLength": 1 },
        "core_activity_ids": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonical_id" }
        },
        "reinforcement_activity_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/canonical_id" }
        }
      }
    }
  }
}
